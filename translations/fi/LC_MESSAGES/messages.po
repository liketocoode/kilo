msgid "You are now signed out on all other browsers and devices."
msgstr "Olet nyt kirjautunut ulos kaikilla muilla selaimilla ja laitteilla."

msgid "Download your data first."
msgstr "Lataa ensin tietosi."

msgid "Sign in again to confirm this request."
msgstr "Kirjaudu uudelleen sisään vahvistaaksesi pyynnön."

#, python-format
msgid "We sent a confirmation code to %(email)s."
msgstr "Lähetimme vahvistuskoodin osoitteeseen %(email)s."

msgid "Enter the 6-digit code."
msgstr "Anna 6-numeroinen koodi."

msgid "That code has expired. Request a new one."
msgstr "Koodi on vanhentunut. Pyydä uusi koodi."

msgid "Too many attempts. Request a new code."
msgstr "Liian monta yritystä. Pyydä uusi koodi."

msgid "Incorrect code."
msgstr "Virheellinen koodi."

msgid "Your account and all your data have been removed."
msgstr "Tilisi ja kaikki tietosi on poistettu."

msgid "Enter your email to sign in."
msgstr "Kirjoita sähköpostiosoitteesi kirjautuaksesi sisään."

#, python-format
msgid "We sent a verification code to %(email)s."
msgstr "Lähetimme varmennuskoodin osoitteeseen %(email)s."

msgid "Enter your email to get a verification code."
msgstr "Kirjoita sähköpostiosoitteesi saadaksesi varmennuskoodin."

msgid "Email verified — you're signed in."
msgstr "Sähköposti vahvistettu – olet kirjautunut sisään."

#, python-format
msgid "We sent a new code to %(email)s."
msgstr "Lähetimme uuden koodin osoitteeseen %(email)s."

msgid "Signed out."
msgstr "Olet kirjautunut ulos."

#. NOTE: date,weight[,note] names the columns of a CSV line; translate the
#. names (note is optional).
#, python-format
msgid "line %(line)d: expected date,weight[,note]"
msgstr "rivi %(line)d: odotettiin päivämäärä,paino[,muistiinpano]"

#, python-format
msgid "line %(line)d: invalid date %(value)s"
msgstr "rivi %(line)d: virheellinen päivämäärä %(value)s"

#, python-format
msgid "line %(line)d: invalid weight %(value)s"
msgstr "rivi %(line)d: virheellinen paino %(value)s"

#, python-format
msgid "line %(line)d: weight out of range"
msgstr "rivi %(line)d: paino alueen ulkopuolella"

#. NOTE: The email subject; the code is at the end, with no full stop, so it
#. can be copied.
#, python-format
msgid "Your verification code is %(code)s"
msgstr "Varmennuskoodisi on %(code)s"

#, python-format
msgid ""
"Your verification code is %(code)s.\n"
"\n"
"It expires in %(num)d minute. If you didn't request this, ignore this email."
msgid_plural ""
"Your verification code is %(code)s.\n"
"\n"
"It expires in %(num)d minutes. If you didn't request this, ignore this email."
msgstr[0] ""
"Varmennuskoodisi on %(code)s.\n"
"\n"
"Koodi vanhenee %(num)d minuutin kuluttua. Jos et pyytänyt sitä, voit jättää "
"tämän sähköpostin huomiotta."
msgstr[1] ""
"Varmennuskoodisi on %(code)s.\n"
"\n"
"Koodi vanhenee %(num)d minuutin kuluttua. Jos et pyytänyt sitä, voit jättää "
"tämän sähköpostin huomiotta."

msgid "Confirm removal of your data"
msgstr "Vahvista tietojesi poistaminen"

#, python-format
msgid ""
"Your confirmation code is %(code)s.\n"
"\n"
"Entering it will permanently delete your account and all your weight data. "
"It expires in %(num)d minute. If you didn't request this, ignore this email "
"and your data stays untouched."
msgid_plural ""
"Your confirmation code is %(code)s.\n"
"\n"
"Entering it will permanently delete your account and all your weight data. "
"It expires in %(num)d minutes. If you didn't request this, ignore this email"
" and your data stays untouched."
msgstr[0] ""
"Vahvistuskoodisi on %(code)s.\n"
"\n"
"Kun annat sen, tilisi ja kaikki painotietosi poistetaan pysyvästi. Koodi "
"vanhenee %(num)d minuutin kuluttua. Jos et pyytänyt sitä, jätä tämä "
"sähköposti huomiotta, niin tietosi säilyvät koskemattomina."
msgstr[1] ""
"Vahvistuskoodisi on %(code)s.\n"
"\n"
"Kun annat sen, tilisi ja kaikki painotietosi poistetaan pysyvästi. Koodi "
"vanhenee %(num)d minuutin kuluttua. Jos et pyytänyt sitä, jätä tämä "
"sähköposti huomiotta, niin tietosi säilyvät koskemattomina."

msgid "That email domain doesn't accept mail (no MX record)."
msgstr "Tämä sähköpostin verkkotunnus ei vastaanota viestejä (ei MX-tietuetta)."

msgid "Couldn't check that email domain right now. Try again."
msgstr "Sähköpostin verkkotunnusta ei voitu tarkistaa juuri nyt. Yritä uudelleen."

msgid "Your session has expired. Reload the page and try again."
msgstr "Istuntosi on vanhentunut. Lataa sivu uudelleen ja yritä uudelleen."

msgid "Your session has expired and nothing was changed. Please try again."
msgstr "Istuntosi on vanhentunut eikä muutoksia tehty. Yritä uudelleen."

msgid "That page isn't available, so you were taken to the start page."
msgstr "Sivu ei ole saatavilla, joten sinut on ohjattu aloitussivulle."

#, python-format
msgid ""
"The file is too large: the limit is %(size)s. Nothing was imported or "
"changed."
msgstr "Tiedosto on liian suuri: raja on %(size)s. Mitään ei tuotu eikä muutettu."

msgid "Something went wrong on our side. Please try again in a moment."
msgstr "Jotain meni vikaan meidän päässämme. Yritä hetken päästä uudelleen."

msgid "Email"
msgstr "Sähköpostiosoite"

msgid "Verification code"
msgstr "Varmennuskoodi"

msgid "Enter the height as a plain number, e.g. 180 or 1.8."
msgstr "Anna pituus pelkkänä lukuna, esim. 180 tai 1,8."

#. NOTE: Label of the body height field in the settings.
msgid "Height"
msgstr "Pituus"

msgid "Unit"
msgstr "Yksikkö"

msgid "Dark mode"
msgstr "Tumma tila"

msgid "Moving average (days)"
msgstr "Liukuva keskiarvo (päivää)"

#, python-format
msgid ""
"Height must be between %(min_cm)s and %(max_cm)s cm (%(min_m)s and %(max_m)s"
" m)."
msgstr "Pituuden on oltava %(min_cm)s–%(max_cm)s cm (%(min_m)s–%(max_m)s m)."

#. NOTE: Switch in the settings that makes the weight chart visible on a public
#. web page.
msgid "Share my chart on a public page"
msgstr "Jaa kaavioni julkisella sivulla"

#. NOTE: Switch in the settings: show the boxes with the current average, BMI
#. and changes under the public chart.
#. NOTE: Switch in the settings: show the kilograms on the public chart, or
#. only the shape of the line.
msgid "Show my weight"
msgstr "Näytä painoni"

msgid "Show the stat boxes on the public page"
msgstr "Näytä tilastoruudut julkisella sivulla"

#. NOTE: Label of the field with the last part of the public page's address
#. (the "ramon" in .../public/ramon).
msgid "Page ID"
msgstr "Sivun tunnus"

#, python-format
msgid "Use %(min)d to %(max)d letters (a-z), digits, hyphens or underscores."
msgstr ""
"Käytä %(min)d–%(max)d kirjainta (a-z), numeroita, yhdysviivoja tai "
"alaviivoja."

msgid "That ID is already taken. Choose another one."
msgstr "Tunnus on jo käytössä. Valitse toinen."

msgid "CSV or XML file"
msgstr "CSV- tai XML-tiedosto"

msgid "CSV, XML or text files only."
msgstr "Vain CSV-, XML- tai tekstitiedostoja."

#, python-format
msgid "That file stores weights in %(unit)s, which can't be imported."
msgstr "Tiedosto tallentaa painot yksikössä %(unit)s, jota ei voi tuoda."

msgid "That file isn't a valid Hacker's Diet XML export."
msgstr "Tiedosto ei ole kelvollinen Hacker's Dietin XML-vienti."

#, python-format
msgid "%(date)s: invalid date"
msgstr "%(date)s: virheellinen päivämäärä"

#, python-format
msgid "%(date)s: invalid weight %(value)s"
msgstr "%(date)s: virheellinen paino %(value)s"

#, python-format
msgid "%(date)s: weight out of range"
msgstr "%(date)s: paino alueen ulkopuolella"

#. NOTE: Rate of weight change. %(grams)s is a signed whole number; g is gram.
#, python-format
msgid "%(grams)s g/day"
msgstr "%(grams)s g/pv"

#. NOTE: Shown when too many sign-in codes were requested. %(num)d is a number
#. of minutes.
#, python-format
msgid "Too many requests. Try again in %(num)d minute."
msgid_plural "Too many requests. Try again in %(num)d minutes."
msgstr[0] "Liian monta pyyntöä. Yritä uudelleen %(num)d minuutin kuluttua."
msgstr[1] "Liian monta pyyntöä. Yritä uudelleen %(num)d minuutin kuluttua."

#. NOTE: Chart range button: the whole recorded history.
msgid "All"
msgstr "Kaikki"

#. NOTE: Chart range button: 20 years. The letter is the unit, Y for year.
msgid "20Y"
msgstr "20v"

#. NOTE: Chart range button: 15 years. The letter is the unit, Y for year.
msgid "15Y"
msgstr "15v"

#. NOTE: Chart range button: 10 years. The letter is the unit, Y for year.
msgid "10Y"
msgstr "10v"

#. NOTE: Chart range button: 5 years. The letter is the unit, Y for year.
msgid "5Y"
msgstr "5v"

#. NOTE: Chart range button: 1 year. The letter is the unit, Y for year.
msgid "1Y"
msgstr "1v"

#. NOTE: Chart range button: 6 months. The letter is the unit, M for month.
msgid "6M"
msgstr "6kk"

#. NOTE: Chart range button: 3 months. The letter is the unit, M for month.
msgid "3M"
msgstr "3kk"

#. NOTE: Chart range button: 1 month. The letter is the unit, M for month.
msgid "1M"
msgstr "1kk"

#. NOTE: Chart range button: 2 weeks. The letter is the unit, W for week.
msgid "2W"
msgstr "2vk"

#. NOTE: Chart range button: 1 week. The letter is the unit, W for week.
msgid "1W"
msgstr "1vk"

#, python-format
msgid "%(num)d-day change"
msgid_plural "%(num)d-day change"
msgstr[0] "%(num)d päivän muutos"
msgstr[1] "%(num)d päivän muutos"

msgid "Invalid date."
msgstr "Virheellinen päivämäärä."

#, python-format
msgid ""
"%(weight)s is %(percent)s%% different from your entry of %(other)s on "
"%(date)s."
msgstr "%(weight)s poikkeaa %(percent)s %% merkinnästäsi %(other)s (%(date)s)."

msgid "Enter a valid weight, like 72.5."
msgstr "Anna kelvollinen paino, esim. 72,5."

#, python-format
msgid "Weight must be between %(min)s and %(max)s kg."
msgstr "Painon on oltava %(min)s–%(max)s kg."

msgid "Invalid range."
msgstr "Virheellinen alue."

msgid "Settings updated."
msgstr "Asetukset päivitetty."

msgid "Your chart is now public."
msgstr "Kaaviosi on nyt julkinen."

msgid "Your chart is no longer public."
msgstr "Kaaviosi ei ole enää julkinen."

#, python-format
msgid "Imported %(num)d entry."
msgid_plural "Imported %(num)d entries."
msgstr[0] "%(num)d merkintä tuotu."
msgstr[1] "%(num)d merkintää tuotu."

#, python-format
msgid "Your height was set to %(height)s."
msgstr "Pituudeksesi asetettiin %(height)s."

#, python-format
msgid "%(num)d note without a weight was skipped."
msgid_plural "%(num)d notes without a weight were skipped."
msgstr[0] "%(num)d muistiinpano ilman painoa ohitettiin."
msgstr[1] "%(num)d muistiinpanoa ilman painoa ohitettiin."

#, python-format
msgid "%(details)s (+%(count)d more)"
msgstr "%(details)s (+%(count)d lisää)"

#, python-format
msgid "Skipped %(num)d invalid line: %(details)s"
msgid_plural "Skipped %(num)d invalid lines: %(details)s"
msgstr[0] "%(num)d virheellinen rivi ohitettu: %(details)s"
msgstr[1] "%(num)d virheellistä riviä ohitettu: %(details)s"

msgid "No rows found in the file."
msgstr "Tiedostosta ei löytynyt rivejä."

msgid "Back"
msgstr "Takaisin"

msgid "About"
msgstr "Tietoja"

msgid "Back to the dashboard"
msgstr "Takaisin yleisnäkymään"

msgid "About Kilo Tracker"
msgstr "Tietoja Kilo Trackerista"

#, python-format
msgid ""
"For many years I tracked my weight with %(hdo_link)s, created by "
"%(walker_link)s. It kept working for a good while after his death, but in "
"March 2026 it finally stopped."
msgstr ""
"Seurasin painoani monta vuotta palvelulla %(hdo_link)s, jonka loi "
"%(walker_link)s. Se toimi vielä pitkään hänen kuolemansa jälkeen, mutta "
"maaliskuussa 2026 se lopulta lakkasi toimimasta."

#, python-format
msgid ""
"I tried %(yadt_link)s as a replacement, but its interface wasn't for me. So "
"I vibe-coded my own version, and Kilo Tracker is the result. It's free for "
"anyone to use."
msgstr ""
"Kokeilin korvaajaksi palvelua %(yadt_link)s, mutta sen käyttöliittymä ei "
"sopinut minulle. Niinpä tein oman versioni vibe codingilla, ja tulos on Kilo"
" Tracker. Se on ilmainen kaikille."

#, python-format
msgid ""
"Kilo Tracker is open source software. You can download the source code and "
"run your own copy from %(github_link)s."
msgstr ""
"Kilo Tracker on avoimen lähdekoodin ohjelmisto. Voit ladata lähdekoodin ja "
"ajaa oman kopiosi osoitteesta %(github_link)s."

#, python-format
msgid "I hope you like it! You can reach me at %(mail_link)s."
msgstr "Toivottavasti pidät siitä! Tavoitat minut osoitteesta %(mail_link)s."

#. Version of the app, with the date of its last change. %(version)s is a link
#. such as v1.2 or a commit id.
#, python-format
msgid "Version %(version)s &middot; committed %(date)s"
msgstr "Versio %(version)s &middot; commit %(date)s"

#, python-format
msgid "Version %(version)s"
msgstr "Versio %(version)s"

msgid "How signing in works"
msgstr "Miten kirjautuminen toimii"

#, python-format
msgid ""
"There are no passwords. Enter your email and we send a 6-digit code that's "
"valid for %(num)s minute — enter it and you're signed in."
msgid_plural ""
"There are no passwords. Enter your email and we send a 6-digit code that's "
"valid for %(num)s minutes — enter it and you're signed in."
msgstr[0] ""
"Salasanoja ei ole. Anna sähköpostiosoitteesi, niin lähetämme 6-numeroisen "
"koodin, joka on voimassa %(num)s minuuttia – anna se, ja olet kirjautunut "
"sisään."
msgstr[1] ""
"Salasanoja ei ole. Anna sähköpostiosoitteesi, niin lähetämme 6-numeroisen "
"koodin, joka on voimassa %(num)s minuuttia – anna se, ja olet kirjautunut "
"sisään."

msgid "Gravatar uses"
msgstr "Gravatar"

#, python-format
msgid ""
"We never store your email address itself in our database. Instead we keep a "
"one-way SHA-256 hash of it (the same scheme %(gravatar_hash_link)s)."
msgstr ""
"Emme koskaan tallenna sähköpostiosoitettasi sellaisenaan tietokantaamme. Sen"
" sijaan säilytämme siitä yksisuuntaisen SHA-256-tiivisteen (sama menetelmä, "
"jota %(gravatar_hash_link)s käyttää)."

#, python-format
msgid ""
"That hash also doubles as your Gravatar id — if you have an avatar set up at"
" %(gravatar_link)s, it shows up automatically once you're signed in."
msgstr ""
"Tiiviste toimii myös Gravatar-tunnisteenasi – jos olet määrittänyt avatarin "
"osoitteessa %(gravatar_link)s, se tulee näkyviin automaattisesti "
"kirjauduttuasi sisään."

msgid ""
"Kilo fetches that avatar from Gravatar itself and keeps a copy for a day, so"
" Gravatar never sees your visits, your browser or your IP address."
msgstr ""
"Kilo hakee avatarin itse Gravatarista ja säilyttää siitä kopion vuorokauden,"
" joten Gravatar ei koskaan näe käyntejäsi, selaintasi tai IP-osoitettasi."

#. Label of the menu that picks the language of the website.
msgid "Language"
msgstr "Kieli"

#. First choice in the language menu: follow the language set in the web
#. browser.
msgid "Browser language"
msgstr "Selaimen kieli"

msgid "OK"
msgstr "OK"

msgid "Signed in"
msgstr "Kirjautunut"

msgid "Settings"
msgstr "Asetukset"

msgid "Log out"
msgstr "Kirjaudu ulos"

#. Heading of the page shown when the server had an unexpected error.
msgid "Something went wrong"
msgstr "Jotain meni vikaan"

msgid "If you were saving something, check whether it was saved and try again."
msgstr "Jos olit tallentamassa jotain, tarkista, tallentuiko se, ja yritä uudelleen."

msgid "Back to the start page"
msgstr "Takaisin aloitussivulle"

#. Title of the public page that shows someone's weight chart.
msgid "Weight chart"
msgstr "Painokaavio"

msgid "View or edit note"
msgstr "Näytä tai muokkaa muistiinpanoa"

msgid "No note"
msgstr "Ei muistiinpanoa"

msgid "Add a note…"
msgstr "Lisää muistiinpano…"

#. Tooltip and screen-reader label of the button that opens a panel of emoji to
#. put in a note.
msgid "Insert an emoji"
msgstr "Lisää emoji"

msgid "Cancel"
msgstr "Peruuta"

#. Button that saves a note (verb).
#. Button that saves the settings (verb).
msgid "Save"
msgstr "Tallenna"

#. Label above the latest moving-average weight.
msgid "Current average"
msgstr "Nykyinen keskiarvo"

msgid "No entries yet."
msgstr "Ei vielä merkintöjä."

msgid "No entries yet — add your weight below."
msgstr "Ei vielä merkintöjä – lisää painosi alle."

#. BMI is Body Mass Index; keep the abbreviation people know in your language.
msgid "BMI"
msgstr "BMI"

#. Third line of the BMI box: the body height in metres, for example "Height:
#. 1.86 m". %(height)s already includes the unit.
#, python-format
msgid "Height: %(height)s"
msgstr "Pituus: %(height)s"

msgid "Set your height"
msgstr "Aseta pituutesi"

#, python-format
msgid "Show the %(range)s chart"
msgstr "Näytä kaavio: %(range)s"

msgid "Show the whole history in the chart"
msgstr "Näytä koko historia kaaviossa"

#. Heading of the box about the logged weigh-ins: first date, last date and how
#. many.
msgid "Entries"
msgstr "Merkinnät"

#. The date of the first entry.
msgid "First"
msgstr "Ensimmäinen"

#. The date of the last (most recent) entry.
msgid "Last"
msgstr "Viimeisin"

#. The total number of entries.
msgid "Total"
msgstr "Yhteensä"

msgid "Daily log"
msgstr "Päiväkirja"

msgid "Scroll to the most recent entry"
msgstr "Vieritä viimeisimpään merkintään"

msgid "Most recent entry"
msgstr "Viimeisin merkintä"

#. Column headers of the daily log: the day, the weight in kilograms, and a
#. free-text note.
msgid "Date"
msgstr "Päivä"

msgid "Weight (kg)"
msgstr "Paino (kg)"

msgid "Note"
msgstr "Muistio"

#. Heading above the emoji the user picked most recently.
msgid "Recently used"
msgstr "Viimeksi käytetyt"

msgid "Loading more days…"
msgstr "Ladataan lisää päiviä…"

msgid "Log today's weight?"
msgstr "Kirjataanko tämän päivän paino?"

msgid "You haven't recorded a weight for today yet."
msgstr "Et ole vielä kirjannut painoa tälle päivälle."

msgid "e.g. 82.4"
msgstr "esim. 82,4"

msgid "Skip"
msgstr "Ohita"

msgid "Unusual value"
msgstr "Epätavallinen arvo"

msgid "Correct it"
msgstr "Korjaa"

msgid "Save anyway"
msgstr "Tallenna silti"

#. Button that brings back a weight that was just deleted from the daily log.
msgid "Undo"
msgstr "Kumoa"

#. Title of a dialog: the login session has timed out; the page must be
#. reloaded.
msgid "Session expired"
msgstr "Istunto vanhentunut"

#. Button that reloads the web page.
msgid "Reload page"
msgstr "Lataa sivu uudelleen"

#, python-format
msgid "%(num)d-day average"
msgid_plural "%(num)d-day average"
msgstr[0] "%(num)d päivän keskiarvo"
msgstr[1] "%(num)d päivän keskiarvo"

msgid "Overall average"
msgstr "Kokonaiskeskiarvo"

#, python-format
msgid "BMI (%(num)d-day avg): %(bmi)s"
msgid_plural "BMI (%(num)d-day avg): %(bmi)s"
msgstr[0] "BMI (%(num)d päivän keskiarvo): %(bmi)s"
msgstr[1] "BMI (%(num)d päivän keskiarvo): %(bmi)s"

msgid "Saving…"
msgstr "Tallennetaan…"

msgid "Saved"
msgstr "Tallennettu"

msgid "Could not save"
msgstr "Tallennus epäonnistui"

msgid "Could not save."
msgstr "Tallennus epäonnistui."

msgid "Error saving"
msgstr "Tallennusvirhe"

#, python-format
msgid "Weight of %(date)s removed."
msgstr "Paino päivältä %(date)s poistettu."

msgid "Sign in"
msgstr "Kirjaudu sisään"

msgid "Enter your email and we'll send you a 6-digit code — no password needed."
msgstr ""
"Anna sähköpostiosoitteesi, niin lähetämme sinulle 6-numeroisen koodin – "
"salasanaa ei tarvita."

msgid "Send code"
msgstr "Lähetä koodi"

msgid "How does this work?"
msgstr "Miten tämä toimii?"

#. Shown at a public chart's address when there is no chart there, or its owner
#. stopped sharing it.
msgid "There is no public chart at this address (any more)."
msgstr "Tässä osoitteessa ei ole (enää) julkista kaaviota."

msgid "Remove my data"
msgstr "Poista tietoni"

msgid "Back to settings"
msgstr "Takaisin asetuksiin"

msgid ""
"This permanently deletes your account, all your weigh-ins and notes, and "
"your settings. It can't be undone."
msgstr ""
"Tämä poistaa pysyvästi tilisi, kaikki punnituksesi ja muistiinpanosi sekä "
"asetuksesi. Toimintoa ei voi perua."

msgid "Step 1: Download your data"
msgstr "Vaihe 1: Lataa tietosi"

msgid "download it again"
msgstr "ladata ne uudelleen"

#, python-format
msgid "Downloaded. You can %(again_link)s."
msgstr "Ladattu. Voit %(again_link)s."

msgid "Download a copy of your weigh-ins before they're deleted. This is required."
msgstr "Lataa kopio punnituksistasi ennen kuin ne poistetaan. Tämä on pakollista."

msgid "Download my data (CSV)"
msgstr "Lataa tietoni (CSV)"

msgid "I've downloaded it — continue"
msgstr "Olen ladannut ne – jatka"

msgid "Step 2: Confirm by email"
msgstr "Vaihe 2: Vahvista sähköpostilla"

#, python-format
msgid ""
"We sent a 6-digit code to <strong>%(email)s</strong>. It expires in %(num)s "
"minute."
msgid_plural ""
"We sent a 6-digit code to <strong>%(email)s</strong>. It expires in %(num)s "
"minutes."
msgstr[0] ""
"Lähetimme 6-numeroisen koodin osoitteeseen <strong>%(email)s</strong>. Se "
"vanhenee %(num)s minuutin kuluttua."
msgstr[1] ""
"Lähetimme 6-numeroisen koodin osoitteeseen <strong>%(email)s</strong>. Se "
"vanhenee %(num)s minuutin kuluttua."

msgid "Delete everything"
msgstr "Poista kaikki"

msgid "Resend code"
msgstr "Lähetä koodi uudelleen"

#, python-format
msgid "We'll email a confirmation code to <strong>%(email)s</strong>."
msgstr "Lähetämme vahvistuskoodin osoitteeseen <strong>%(email)s</strong>."

msgid "Send confirmation code"
msgstr "Lähetä vahvistuskoodi"

msgid "Your height is used to calculate your BMI."
msgstr "Pituuttasi käytetään BMI:n laskemiseen."

#. Heading of the settings section about showing the weight chart on a public
#. web page.
msgid "Public chart"
msgstr "Julkinen kaavio"

msgid ""
"Show your chart and stat boxes on a public page that anyone with the link "
"can see, and that you can embed in another website. Your notes, your email "
"address and your daily log are never shown."
msgstr ""
"Näytä kaaviosi ja tilastoruutusi julkisella sivulla, jonka kuka tahansa "
"linkin saanut voi nähdä ja jonka voit upottaa toiseen verkkosivustoon. "
"Muistiinpanojasi, sähköpostiosoitettasi ja päiväkirjaasi ei koskaan näytetä."

msgid ""
"Switched off, the chart shows only the shape of the line: no kilograms, no "
"BMI and no stat boxes."
msgstr ""
"Jos tämä on pois päältä, kaavio näyttää vain viivan muodon: ei kilogrammoja, "
"ei BMI:tä eikä tilastoruutuja."

#, python-format
msgid ""
"The last part of the page's address: %(min)d to %(max)d letters (a-z), "
"digits, hyphens or underscores. Leave it empty for a new random ID."
msgstr ""
"Sivun osoitteen viimeinen osa: %(min)d–%(max)d kirjainta (a-z), numeroita, "
"yhdysviivoja tai alaviivoja. Jätä tyhjäksi, niin saat uuden satunnaisen "
"tunnuksen."

#. Label of a menu in the settings: which period the shared chart shows.
msgid "Chart range"
msgstr "Kaavion aikaväli"

#. First choice of the chart range menu: the chart keeps its range buttons and
#. the visitor picks.
msgid "Visitor chooses (range buttons)"
msgstr "Kävijä valitsee (aikavälipainikkeet)"

msgid "Your public chart:"
msgstr "Julkinen kaaviosi:"

msgid "To show it in another website, put this code in that page's HTML:"
msgstr "Näyttääksesi sen toisella sivustolla lisää tämä koodi sen sivun HTML:ään:"

msgid "Import data"
msgstr "Tuo tiedot"

#. The text in <code> only names the three columns of a line such as
#. 23-9-26,79.7,text. Translate the names (date, weight, note): the file itself
#. has no header and is the same in every language.
msgid ""
"Import weigh-ins from a CSV text file. Each line is "
"<code>date,weight,note</code> (note is optional), for example:"
msgstr ""
"Tuo punnituksia CSV-tekstitiedostosta. Jokainen rivi on muotoa "
"<code>päivämäärä,paino,muistiinpano</code> (muistiinpano on valinnainen), "
"esimerkiksi:"

#. Example notes in the CSV sample. The CSV format itself (dates, dot as
#. decimal separator) stays the same in every language.
msgid "optional notes"
msgstr "valinnaisia muistiinpanoja"

msgid "some text"
msgstr "jotain tekstiä"

#. d-M-yy and d-M-yyyy describe the date pattern, as in 23-9-26 or 23-9-2026.
#. Use the first letter of the word for day, month (keep a capital M, so it
#. cannot be mistaken for minutes) and year in your language, e.g. j-M-aa in
#. French. The numbers in the file are always day-month-year.
msgid ""
"Dates are <code>d-M-yy</code> or <code>d-M-yyyy</code>; weight is in "
"kilograms. Importing a date that already has an entry overwrites it."
msgstr ""
"Päivämäärät ovat muotoa <code>p-K-vv</code> tai <code>p-K-vvvv</code>; paino"
" on kilogrammoina. Jos tuot päivämäärän, jolla on jo merkintä, se korvataan."

#. "The Hacker's Diet Online" and "Yet Another Diet Tool" are names of web
#. services; do not translate them.
msgid ""
"You can also import the CSV or XML export of The Hacker's Diet Online, or "
"the CSV export of Yet Another Diet Tool. Weights, notes and, from the XML "
"file, your height are imported; everything else is ignored."
msgstr ""
"Voit tuoda myös The Hacker's Diet Onlinen CSV- tai XML-viennin tai Yet "
"Another Diet Toolin CSV-viennin. Tuonnissa otetaan mukaan painot ja "
"muistiinpanot (sekä XML-tiedostosta myös pituutesi); kaikki muu ohitetaan."

msgid "Import"
msgstr "Tuo"

msgid "Export data"
msgstr "Vie tiedot"

msgid "Download all your weigh-ins as a CSV file (date, weight in kilograms, note)."
msgstr ""
"Lataa kaikki punnituksesi CSV-tiedostona (päivämäärä, paino kilogrammoina, "
"muistiinpano)."

msgid "Export CSV"
msgstr "Vie CSV"

#. Heading of the settings section that ends the sign-in on every other browser
#. and device.
msgid "Sign out everywhere"
msgstr "Kirjaudu ulos kaikkialta"

msgid ""
"Signed in on a computer that isn't yours, or lost a phone? This signs you "
"out on every other browser and device. You stay signed in here."
msgstr ""
"Kirjauduitko jonkun toisen tietokoneella tai hukkasitko puhelimen? Tämä "
"kirjaa sinut ulos kaikilla muilla selaimilla ja laitteilla. Täällä pysyt "
"edelleen kirjautuneena."

#. Button that ends the sign-in on all other browsers and devices (not on this
#. one).
msgid "Sign out on other devices"
msgstr "Kirjaudu ulos muilta laitteilta"

msgid ""
"Permanently delete your account and all your weigh-ins. You'll be asked to "
"download your data and confirm with a code sent by email first."
msgstr ""
"Poista tilisi ja kaikki punnituksesi pysyvästi. Sinua pyydetään ensin "
"lataamaan tietosi ja vahvistamaan sähköpostitse lähetetyllä koodilla."

msgid "Remove my data…"
msgstr "Poista tietoni…"

msgid "Sign up"
msgstr "Rekisteröidy"

msgid "Enter your email and we'll send you a 6-digit verification code."
msgstr ""
"Anna sähköpostiosoitteesi, niin lähetämme sinulle 6-numeroisen "
"varmennuskoodin."

msgid "Verify your email"
msgstr "Varmenna sähköpostiosoitteesi"

msgid "Enter your code"
msgstr "Anna koodisi"

msgid "Verify"
msgstr "Varmenna"

