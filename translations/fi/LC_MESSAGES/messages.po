# machine-translated
msgid "How signing in works"
msgstr "Miten kirjautuminen toimii"

# machine-translated
#, python-format
msgid ""
"There are no passwords. Enter your email and we send a 6-digit code that's "
"valid for %(num)s minute — enter it and you're signed in."
msgid_plural ""
"There are no passwords. Enter your email and we send a 6-digit code that's "
"valid for %(num)s minutes — enter it and you're signed in."
msgstr[0] ""
"Salasanoja ei ole. Anna sähköpostiosoitteesi, niin lähetämme 6-numeroisen "
"koodin, joka on voimassa %(num)s minuutin – anna se, ja olet kirjautunut "
"sisään."
msgstr[1] ""
